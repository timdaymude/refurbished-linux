#!/bin/sh
# Give the system its own identity.
set -e

cat > /usr/lib/os-release <<'OSR'
PRETTY_NAME="Reawakening OS 0.3.0"
NAME="Reawakening OS"
VERSION_ID="0.3"
VERSION="0.3.0"
VERSION_CODENAME=reawakening
ID=reawakening
ID_LIKE=debian
HOME_URL="https://github.com/timdaymude/refurbished-linux"
DOCUMENTATION_URL="https://github.com/timdaymude/refurbished-linux#readme"
SUPPORT_URL="https://github.com/timdaymude/refurbished-linux/issues"
BUG_REPORT_URL="https://github.com/timdaymude/refurbished-linux/issues"
DEBIAN_CODENAME=trixie
OSR
ln -sf ../usr/lib/os-release /etc/os-release

cat > /etc/issue <<'ISSUE'
Reawakening OS 0.3.0  \n  \l

ISSUE

cat > /etc/lsb-release <<'LSB'
DISTRIB_ID=Reawakening
DISTRIB_RELEASE=0.3
DISTRIB_CODENAME=reawakening
DISTRIB_DESCRIPTION="Reawakening OS 0.3.0"
LSB

echo "reawakening-pc" > /etc/hostname
