#!/bin/sh
# Round 16: a dark, Flatpak-first application store that runs only when asked.
#
# The store is GNOME Software 48 with its Flatpak plugin. The reasons, in short:
# Bazaar (the preferred candidate) needs GTK 4.22 and libadwaita 1.8, and trixie
# ships 4.18 and 1.7, so it can only arrive as a Flatpak that drags in a whole
# GNOME runtime; it also runs a permanent daemon by design. GNOME Software is a
# Debian package, uses the AppStream catalogue this image already builds, and
# reaches both Flatpak (Flathub) and APT through plugins, so apt installs keep
# working for anyone who wants them.
#
# Nothing here starts a background checker: the package service is D-Bus
# activated, GNOME Software's own background service is left disabled, the apt
# daily timers are masked, and its gsettings defaults forbid automatic downloads
# and automatic update checks.
set -e
export DEBIAN_FRONTEND=noninteractive LC_ALL=C

# ---------------------------------------------------------------------------
# 1. PackageKit: the APT backend of GNOME Software
# ---------------------------------------------------------------------------
# 0200-no-background-work masks packagekit.service, and a mask also disables
# D-Bus activation, which is how the store reaches PackageKit. Unmask it and
# leave it disabled: the unit has no [Install] section, so it never starts at
# boot and packagekitd exits after its idle timeout.
systemctl unmask packagekit.service >/dev/null 2>&1 || true
systemctl disable packagekit.service >/dev/null 2>&1 || true
# Offline updates are a second update mechanism of their own; Reawakening
# updates from Settings, so this one stays off.
systemctl mask packagekit-offline-update.service >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# 2. AppStream: the catalogue the DEB side of the store reads
# ---------------------------------------------------------------------------
# On Debian the apt hook fills /var/lib/swcatalog/yaml with symlinks into
# /var/lib/apt/lists, and 0600-slim deletes those lists: every symlink dangles,
# libappstream loads zero components and the store shows empty categories. Ship
# the DEP-11 data itself in the system catalogue directory.
if ! apt-get -o APT::Sandbox::User=root update >/tmp/store-apt.log 2>&1; then
    echo "WARNING: apt-get update failed while building the AppStream catalogue" >&2
    tail -5 /tmp/store-apt.log >&2 || true
fi
install -d /usr/share/swcatalog/yaml
rm -f /usr/share/swcatalog/yaml/debian-*.yml.gz
catalogs=0
for dep11 in /var/lib/apt/lists/*Components-amd64.yml.gz; do
    [ -s "$dep11" ] || continue
    catalogs=$((catalogs + 1))
    cp "$dep11" "/usr/share/swcatalog/yaml/debian-$catalogs.yml.gz"
done
[ "$catalogs" -gt 0 ] ||
    echo "WARNING: no DEP-11 catalogue was downloaded" >&2
rm -rf /var/lib/swcatalog/yaml
rm -rf /var/cache/swcatalog/cache
appstreamcli refresh --source=os --force 2>&1 | tail -3 || true
echo "AppStream: $catalogs catalogue files, $(du -sh /usr/share/swcatalog 2>/dev/null | cut -f1)"

mv /var/lib/apt/lists /tmp/apt-lists-guard 2>/dev/null || true
rm -rf /var/cache/swcatalog/cache
for component in org.videolan.vlc org.gimp.GIMP; do
    if appstreamcli get "$component" >/dev/null 2>&1; then
        echo "AppStream: $component is in the catalogue (without apt lists)"
    else
        echo "WARNING: the AppStream catalogue has no $component entry" >&2
    fi
done
mv /tmp/apt-lists-guard /var/lib/apt/lists 2>/dev/null || true

# ---------------------------------------------------------------------------
# 3. Flatpak: the Flathub remote, system-wide
# ---------------------------------------------------------------------------
# The remote is configured once, here, so a beginner never types a command.
# No runtime is preinstalled: a runtime arrives with the first application that
# needs it, which keeps the image small and lets the user see the cost.
if flatpak remote-add --system --if-not-exists flathub \
        https://flathub.org/repo/flathub.flatpakrepo >/tmp/flathub.log 2>&1; then
    echo "Flatpak: flathub remote configured"
else
    echo "WARNING: could not add the flathub remote" >&2
    tail -5 /tmp/flathub.log >&2 || true
fi
# Filter the remote to the architecture and languages this image uses: the
# alternative would download every translation of every runtime.
flatpak config --system --set languages="en" >/dev/null 2>&1 || true

# ---------------------------------------------------------------------------
# 4. No background store, no background update checks
# ---------------------------------------------------------------------------
# GNOME Software ships a user service that would refresh metadata at login.
# Disable it globally: launching the store from the menu still works, because
# the desktop entry this image installs starts the application directly (see
# /usr/local/share/applications/org.gnome.Software.desktop) rather than asking
# D-Bus for a service that is meant to stay resident.
systemctl --global disable gnome-software.service >/dev/null 2>&1 || true

# Debian's apt-daily timers refresh the package lists once a day whether or not
# anyone asked. Reawakening checks when its owner presses a button, so mask
# both timers and the unattended-upgrade service: an upgrade that runs on its
# own is exactly what the update settings promise never happens.
systemctl disable apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1 || true
systemctl mask apt-daily.timer apt-daily-upgrade.timer >/dev/null 2>&1 || true
systemctl mask apt-daily.service apt-daily-upgrade.service >/dev/null 2>&1 || true
systemctl mask unattended-upgrades.service >/dev/null 2>&1 || true

# gsettings defaults for the store live in includes.chroot, so they are part
# of the tree that check-config can see; compiling them is all that is left.
install -d /etc/dconf/profile /etc/dconf/db/distro.d
dconf update >/dev/null 2>&1 || echo "WARNING: dconf could not compile the defaults" >&2

# ---------------------------------------------------------------------------
# 5. Prove it in the build log, not on a first click
# ---------------------------------------------------------------------------
if dpkg-query -W -f='${Status}' gnome-software 2>/dev/null | grep -q "install ok installed"; then
    echo "Store: gnome-software $(dpkg-query -W -f='${Version}' gnome-software)"
else
    echo "WARNING: gnome-software is not installed" >&2
fi
if [ -f /usr/lib/x86_64-linux-gnu/gnome-software/plugins/libgs_plugin_flatpak.so ]; then
    echo "Store: Flatpak plugin present"
else
    echo "WARNING: the Flatpak plugin for gnome-software is missing" >&2
fi
if flatpak remotes --system 2>/dev/null | grep -q '^flathub'; then
    echo "Store: flathub remote visible to flatpak"
else
    echo "WARNING: flatpak does not list the flathub remote" >&2
fi
if dpkg-query -W -f='${Status}' dde-store 2>/dev/null | grep -q "install ok installed"; then
    echo "WARNING: dde-store is still installed; one store only" >&2
fi

# The menu entry must exist and must be the one the launcher shows.
if [ -f /usr/share/applications/org.gnome.Software.desktop ] ||
   [ -f /usr/local/share/applications/org.gnome.Software.desktop ]; then
    echo "Store: menu entry present"
else
    echo "WARNING: the store has no desktop entry" >&2
fi

# A polkit agent turns "Not authorized" into a password prompt.
[ -x /usr/libexec/polkit-mate-authentication-agent-1 ] &&
    echo "Polkit: agent present" ||
    echo "WARNING: polkit agent is missing" >&2

rm -f /tmp/store-apt.log /tmp/flathub.log
