#!/bin/sh
# Make the session start at boot, and make the helpers usable.
set -e

# Seat management fallback. libseat uses logind for the real login session; seatd
# stays installed and running so the compositor still gets DRM and VT access if
# it is ever started outside a logind session (a recovery shell, for example).
systemctl enable seatd.service >/dev/null 2>&1 || true
systemctl start seatd.service >/dev/null 2>&1 || true
for group in _seatd seatd; do
    getent group "$group" >/dev/null 2>&1 || continue
    for account in refurb user; do
        id "$account" >/dev/null 2>&1 && usermod -aG "$group" "$account" || true
    done
done

# Networking and Bluetooth: both are installed, but a package being present
# does not mean its service starts. 0.3.0 never enabled bluetooth.service, so
# the adapter stayed down, the quick-settings tile said "Not available" and
# scanning could never return anything.
systemctl enable NetworkManager.service >/dev/null 2>&1 || true
# `systemctl enable` inside a build chroot can fall back to the SysV helper and
# return success without creating the unit symlink (that is how 0.3.0 shipped
# with Bluetooth present but never started). Create the link explicitly.
ln -sf /usr/lib/systemd/system/bluetooth.service \
       /etc/systemd/system/multi-user.target.wants/bluetooth.service
# Some laptops ship with the radio soft-blocked; clear it before BlueZ starts.
mkdir -p /etc/systemd/system/bluetooth.service.d
cat > /etc/systemd/system/bluetooth.service.d/10-refurb-rfkill.conf <<'CONF'
[Service]
ExecStartPre=-/usr/sbin/rfkill unblock bluetooth
CONF

# The desktop is no longer a system unit. It starts from the account's own
# login session on tty1 (pam_systemd registers a real logind session: seat,
# XDG_SESSION_ID, systemd --user, active polkit subject). An image upgraded
# from r7 still has the old unit enabled, so remove that link explicitly.
systemctl disable refurb-session.service >/dev/null 2>&1 || true
rm -f /etc/systemd/system/graphical.target.wants/refurb-session.service 2>/dev/null || true
systemctl enable refurb-session-prepare.service >/dev/null 2>&1 || true
ln -sf /usr/lib/systemd/system/refurb-session-prepare.service \
       /etc/systemd/system/multi-user.target.wants/refurb-session-prepare.service
# tty1 carries the desktop (autologin drop-in in /etc/systemd/system);
# tty2-tty6 stay recovery consoles with a normal login prompt.
systemctl enable getty@tty1.service >/dev/null 2>&1 || true
ln -sf /usr/lib/systemd/system/getty@.service \
       /etc/systemd/system/getty.target.wants/getty@tty1.service

# Audio inside the user session. Debian ships these units, but enabling them is
# a `systemctl --user preset` step that cannot run in a build chroot, so the
# wants links are created here: pipewire and pipewire-pulse are socket
# activated, and wireplumber is pulled in by pipewire. Before this round they
# were not enabled at all and the session launcher had to spawn the daemons by
# hand, outside systemd, where nothing could restart them.
# Flatpak's document portal is not used by anything on this image and needs
# FUSE, which a live system does not provide: it failed on every boot (D-Bus
# activation from the browser) and left `systemctl --user` reporting "degraded".
# Masked rather than shipped as a failed unit.
for unit in xdg-document-portal.service xdg-permission-store.service \
            xdg-desktop-portal.service; do
    ln -sf /dev/null "/etc/systemd/user/$unit"
done

install -d /etc/systemd/user/sockets.target.wants /etc/systemd/user/pipewire.service.wants
for unit in pipewire.socket pipewire-pulse.socket; do
    [ -f "/usr/lib/systemd/user/$unit" ] && \
        ln -sf "/usr/lib/systemd/user/$unit" "/etc/systemd/user/sockets.target.wants/$unit"
done
[ -f /usr/lib/systemd/user/wireplumber.service ] && \
    ln -sf /usr/lib/systemd/user/wireplumber.service \
           /etc/systemd/user/pipewire.service.wants/wireplumber.service
# Memory report: enabled but inert unless refurb.measure=1 is on the cmdline.
systemctl enable refurb-diag.service >/dev/null 2>&1 || true
# Recovery route: Ctrl+Alt+F2..F6 always gives a text login, even if the
# graphical session fails. tty1 belongs to the desktop session.
# live-config drops an autologin for a user called "user"; this image has no
# such account, so every getty failed and restarted in a loop (visible as
# pam_unix "could not identify user"). The desktop does not need a text
# autologin, and tty2-6 are recovery consoles with a normal login.
rm -f /etc/systemd/system/getty@tty*.service.d/autologin.conf 2>/dev/null || true
rm -f /etc/systemd/system/getty@.service.d/autologin.conf 2>/dev/null || true
for vt in 2 3 4 5 6; do
    systemctl enable "getty@tty${vt}.service" >/dev/null 2>&1 || true
done
systemctl set-default graphical.target >/dev/null 2>&1 || true

for program in /usr/lib/refurb/refurb-update \
               /usr/lib/refurb/session-start /usr/lib/refurb/shell-supervisor \
               /usr/lib/refurb/session-launch /usr/lib/refurb/refurb-control \
               /usr/lib/refurb/osd-start /usr/lib/refurb/tty1-autologin \
               /usr/lib/refurb/refurb-diag /usr/lib/refurb/refurb-keys \
               /usr/lib/refurb/refurb-cockpit /usr/lib/refurb/session-inhibit \
               /usr/lib/refurb/memory-report /usr/bin/refurb-session; do
    [ -f "$program" ] && chmod 0755 "$program"
done
# One name for the hardware controls, callable from a terminal and from the
# diagnostics script. The labwc keybinds use the absolute path, but a user who
# types `refurb-control volume up` should not have to know where it lives.
ln -sf /usr/lib/refurb/refurb-control /usr/local/bin/refurb-control
# Diagnostics are meant to be typed by whoever is testing the laptop, from a
# terminal, without knowing where the script lives.
ln -sf /usr/lib/refurb/refurb-diag /usr/local/bin/refurb-diag
ln -sf /usr/lib/refurb/refurb-keys /usr/local/bin/refurb-keys
# Remote administration: one command that says what Cockpit is doing and how to
# reach it from another computer, instead of a browser page that never answers.
ln -sf /usr/lib/refurb/refurb-cockpit /usr/local/bin/refurb-cockpit

chmod 0440 /etc/sudoers.d/refurb-helpers
# The live medium's passwordless rule is a separate file so the installer can
# delete exactly that and leave the two helper rules in place. visudo validates
# it here: a typo in a sudoers file breaks sudo for the whole image.
if [ -f /etc/sudoers.d/50-refurb-live ]; then
    chmod 0440 /etc/sudoers.d/50-refurb-live
    visudo -c -f /etc/sudoers.d/50-refurb-live >/dev/null
fi

# The live medium needs a real human account: the desktop session runs as it,
# and the session launcher looks for the first uid >= 1000. An installed system
# replaces this with the account the user creates in the installer.
if ! getent passwd 1000 >/dev/null 2>&1; then
    useradd -m -u 1000 -s /bin/bash -c "Reawakening OS" refurb || true
    passwd -d refurb >/dev/null 2>&1 || true
fi
for account in refurb user; do
    id "$account" >/dev/null 2>&1 || continue
    for group in video netdev audio input render sudo; do
        getent group "$group" >/dev/null 2>&1 && usermod -aG "$group" "$account" || true
    done
done

