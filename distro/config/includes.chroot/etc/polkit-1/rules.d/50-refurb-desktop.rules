// Refurbished Linux: two deliberate exceptions, and nothing else.
//
// The desktop is a real logind session now (a normal PAM login on tty1), so the
// shipped policy already authorizes everything a local active user should have:
//
//   org.freedesktop.NetworkManager.network-control   allow_active = yes
//   org.freedesktop.udisks2.filesystem-mount         allow_active = yes
//   org.freedesktop.udisks2.eject-media              allow_active = yes
//   org.freedesktop.udisks2.power-off-drive           allow_active = yes
//   org.freedesktop.NM-libnm / BlueZ agent traffic    no polkit action at all
//
// r7 carried broad wildcards for NetworkManager, BlueZ, Blueman and udisks2
// because a session started from a system unit was never "active" and every one
// of those actions was refused. Those wildcards are gone.
//
// What remains are the two actions Debian's policy sets to auth_admin_keep even
// for an active local session, in a session that has no authentication agent, so
// they could only ever fail:
//
//   NetworkManager.settings.modify.system  saving a Wi-Fi profile (the "new
//                                          network" path in the connection
//                                          editor) writes to /etc, not to the
//                                          user's own settings;
//   blueman.rfkill.setstate                Blueman's radio power switch.
//
// Membership in netdev is granted to the desktop account by the image build, so
// the person who can already read and change the network can do these two.
// Partitioning, formatting, mounting another seat's or another user's disk, and
// every administrator action stay refused.
var allowed = [
    "org.freedesktop.NetworkManager.settings.modify.system",
    "org.blueman.rfkill.setstate"
];

polkit.addRule(function (action, subject) {
    if (!subject.isInGroup("netdev")) {
        return null;
    }
    for (var i = 0; i < allowed.length; i++) {
        if (action.id === allowed[i]) {
            return polkit.Result.YES;
        }
    }
    return null;
});
