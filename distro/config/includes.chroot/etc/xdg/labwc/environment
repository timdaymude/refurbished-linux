XDG_CURRENT_DESKTOP=refurb
XDG_SESSION_TYPE=wayland
BROWSER=brave-browser
MOZ_ENABLE_WAYLAND=1
QT_QPA_PLATFORM=wayland
GDK_BACKEND=wayland,x11
XCURSOR_SIZE=24
GTK_THEME=Adwaita:dark
QT_STYLE_OVERRIDE=Adwaita-Dark

# No LIBSEAT_BACKEND: libseat uses logind in a real login session and falls
# back to seatd if there is none, which is the order this image wants.

# Software renderer fallback for machines without a usable GPU.
WLR_RENDERER_ALLOW_SOFTWARE=1
