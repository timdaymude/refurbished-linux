<?xml version="1.0"?>
<!-- Reawakening OS: labwc configuration.
     Window management is deliberately conventional (stacked windows, Super
     for the launcher, Alt-Tab to switch) so that a Windows user is at home
     immediately. Animations and shadows are off. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <core>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowSnapping>yes</allowSnapping>
    <reuseOutputMode>yes</reuseOutputMode>
    <primarySelection>true</primarySelection>
  </core>

  <placement>
    <policy>center</policy>
  </placement>

  <theme>
    <!-- This theme ships in the image (usr/share/themes/refurb). The r8 image
         asked for "Clearlooks", which is not installed, so labwc fell back to
         its own decoration and the titlebar buttons were not the ones described
         here. The layout spells the maximize button out instead of relying on a
         default. -->
    <name>refurb</name>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow">
      <name>Inter</name><size>10</size><weight>normal</weight>
    </font>
    <font place="InactiveWindow">
      <name>Inter</name><size>10</size><weight>normal</weight>
    </font>
    <font place="MenuItem">
      <name>Inter</name><size>10</size><weight>normal</weight>
    </font>
    <font place="OnScreenDisplay">
      <name>Inter</name><size>11</size><weight>bold</weight>
    </font>
  </theme>

  <windowRules>
    <!-- The shell draws its own headers for these two windows. -->
    <windowRule identifier="refurb-software" serverDecoration="no" />
    <windowRule identifier="refurb-settings" serverDecoration="no" />
  </windowRules>

  <keyboard>
    <default />
    <keybind key="W-space">
      <action name="Execute"><command>refurb-shell --send launcher</command></action>
    </keybind>
    <keybind key="W-Return">
      <action name="Execute"><command>foot</command></action>
    </keybind>
    <keybind key="W-e">
      <action name="Execute"><command>pcmanfm</command></action>
    </keybind>
    <keybind key="W-s">
      <action name="Execute"><command>refurb-shell --send software</command></action>
    </keybind>
    <keybind key="W-comma">
      <action name="Execute"><command>refurb-shell --send settings</command></action>
    </keybind>
    <keybind key="W-l">
      <action name="Execute"><command>refurb-shell --send lock</command></action>
    </keybind>
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize" />
    </keybind>
    <!-- Maximate/restore and true full-screen are different things and both
         are reachable without hunting for a button: Super+Up/Down resize to
         the working area (above the bar), F11 removes the decorations. -->
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="UnMaximize" />
    </keybind>
    <keybind key="F11">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-F11">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <!-- Support: collect the hardware and session diagnostics in a terminal.
         Nothing is uploaded; the archive is written under $HOME. -->
    <keybind key="W-d">
      <action name="Execute"><command>foot -e sh -c 'refurb-diag; printf "\nPress Enter to close "; read -r _'</command></action>
    </keybind>
    <keybind key="Print">
      <action name="Execute"><command>sh -c 'mkdir -p "$HOME/Pictures" &amp;&amp; grim "$HOME/Pictures/screenshot-$(date +%F-%H%M%S).png"'</command></action>
    </keybind>
    <!-- Media and brightness keys. All five go through refurb-control, which
         applies the 160% volume ceiling and shows the OSD, so the keys, the
         bar and the settings sliders cannot drift apart. -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control volume up</command></action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control volume down</command></action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control mute</command></action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control brightness up</command></action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control brightness down</command></action>
    </keybind>
    <!-- Fallbacks for keyboards whose top row does not reach the compositor as
         XF86 keysyms. A Chromebook's top row is back, forward, refresh,
         fullscreen, overview, brightness down, brightness up, mute, volume down,
         volume up; when the firmware reports them as F-keys the numbers below
         match that order. Super is used so the plain F-keys stay with the
         application. -->
    <keybind key="W-F6">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control brightness down</command></action>
    </keybind>
    <keybind key="W-F7">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control brightness up</command></action>
    </keybind>
    <keybind key="W-F8">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control mute</command></action>
    </keybind>
    <keybind key="W-F9">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control volume down</command></action>
    </keybind>
    <keybind key="W-F10">
      <action name="Execute"><command>/usr/lib/refurb/refurb-control volume up</command></action>
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- Double-clicking a titlebar maximizes and restores, the way it does on
         every other desktop. -->
    <context name="Titlebar">
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Frame">
      <mousebind button="A-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
  </mouse>
</openbox_config>
