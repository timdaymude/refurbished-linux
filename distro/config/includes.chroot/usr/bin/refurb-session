#!/bin/sh
# The Reawakening OS desktop session: environment, first-run welcome, labwc.
#
# This runs as the account's own login session on tty1 (see
# /etc/profile.d/zz-refurb-desktop.sh), so XDG_RUNTIME_DIR, XDG_SESSION_ID and
# the systemd user instance already exist. It no longer wraps everything in
# `dbus-run-session`: the session bus is the user's real bus, shared with
# pipewire, wireplumber and every application, which is what makes the audio
# sockets and the notification service belong to the session rather than to one
# private process tree.
set -u

# labwc starts its autostart script and the keybinds with whatever PATH it
# inherits. Without this, `command -v wob` and the media keys could not find
# anything outside a login shell, and the OSD silently never started.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

export XDG_CURRENT_DESKTOP=refurb
export XDG_SESSION_DESKTOP=refurb
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland,x11
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export BROWSER=brave-browser
export ELECTRON_OZONE_PLATFORM_HINT=auto
# Dark is the default everywhere, including GTK apps and Chromium's UI.
export GTK_THEME=Adwaita:dark
export QT_STYLE_OVERRIDE=Adwaita-Dark

# Machines with no usable GPU (virtual machines, very old integrated graphics)
# must still get a desktop: let wlroots fall back to a software renderer
# instead of refusing to start. Hardware GL is used whenever it exists.
export WLR_RENDERER_ALLOW_SOFTWARE=1
# libseat is not pinned to seatd any more: with a real logind session its
# default order (logind first, seatd as fallback) is exactly right.

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
# dbus-user-session provides the user bus at $XDG_RUNTIME_DIR/bus; naming it
# explicitly means a shell started without the PAM environment still finds it.
if [ -S "$XDG_RUNTIME_DIR/bus" ] && [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

mkdir -p "$HOME/Documents" "$HOME/Downloads" "$HOME/Pictures" 2>/dev/null || true
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update >/dev/null 2>&1 || true

# First boot: one page that explains the machine and links to Microsoft 365.
# Cosmetic only: if the marker cannot be written (read-only home, odd
# ownership) the desktop still starts.
welcome_marker="$HOME/.config/refurb/welcomed"
if [ ! -f "$welcome_marker" ] && mkdir -p "$HOME/.config/refurb" 2>/dev/null \
        && : > "$welcome_marker" 2>/dev/null; then
    ( sleep 5; exec brave-browser --new-window \
        "file:///usr/share/refurb/welcome/index.html" ) >/dev/null 2>&1 &
fi

exec /usr/lib/refurb/session-launch
