#!/bin/sh
# Install, remove or look for Debian packages on behalf of the Software window.
# Arguments are validated here: the caller cannot pass options to apt.
set -eu

verb="${1:-}"
package="${2:-}"

case "$verb" in
    install|remove) ;;
    *) echo "usage: refurb-apt install|remove <package>" >&2; exit 2 ;;
esac

case "$package" in
    ''|*[!a-z0-9+._-]*|-*)
        echo "refurb-apt: invalid package name" >&2
        exit 2
        ;;
esac

export DEBIAN_FRONTEND=noninteractive
export LC_ALL=C

exec apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$verb" "$package"
