#!/bin/sh
# refurb-cockpit - Cockpit on this computer and, deliberately, on the network.
#
# Cockpit is installed and socket activated, and the image binds it to
# 127.0.0.1 only: a live USB with no password on its desktop account must not
# offer a web login to the whole network. Remote administration is therefore a
# switch the user throws, and it needs the account's own password because
# that is what Cockpit will ask for at the login page. Cockpit is never
# exposed to the internet by this script - only the local network can reach it,
# and port 9090 stays closed unless this is run.
#
#   refurb-cockpit            show the state and what to do
#   refurb-cockpit on|off     allow or refuse access from the local network
#   refurb-cockpit password   set this account's password (Cockpit login)
#   refurb-cockpit ip         print the addresses other computers can use
#   refurb-cockpit state      machine-readable state for Settings -> Remote
#   refurb-cockpit open       open the local Cockpit page in the browser
#
# The shipped socket drop-in is 10-refurb-loopback.conf; this script writes
# 50-refurb-remote.conf, which systemd reads after it. The previous reverse
# order meant `on` was silently undone by the loopback file, which is why the
# page stayed unreachable from another computer. Cockpit speaks HTTPS, so every
# address printed here is https://.
#
# Settings -> Remote runs `pkexec refurb-cockpit on|off`, so this script also
# has to work when polkit started it: PKEXEC_UID names the account that asked,
# and `id -un` would answer "root".
set -u

PANEL=/usr/lib/refurb
DROPIN=/etc/systemd/system/cockpit.socket.d/50-refurb-remote.conf
LOOPBACK=127.0.0.1

have() { command -v "$1" >/dev/null 2>&1; }

say() { printf '%s\n' "$*"; }

addresses() {
    if have ip; then
        ip -o -4 addr show scope global 2>/dev/null |
            awk '{print $2 " " $4}' | cut -d/ -f1
    elif have hostname; then
        # An image built before iproute2 was added still has hostname(1).
        hostname -I 2>/dev/null |
            awk '{for (i = 1; i <= NF; i++) print "network " $i}'
    fi
}

# "P" when a password is set, "NP" when the account has none, "L" when locked.
password_state() {
    if have passwd; then
        passwd -S "$(current_user)" 2>/dev/null | awk '{print $2}'
    fi
}

remote_enabled() {
    [ -f "$DROPIN" ]
}

# The account Cockpit will ask to log in as: sudo's caller, polkit's caller, or
# the current user. Under pkexec `id -un` is root, which is never a valid
# Cockpit login (root is in /etc/cockpit/disallowed-users).
current_user() {
    if [ -n "${PKEXEC_UID:-}" ] && have getent; then
        getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f1
    elif [ -n "${SUDO_USER:-}" ]; then
        printf '%s\n' "$SUDO_USER"
    else
        id -un
    fi
}

# Parsed by the shell's Settings -> Remote panel (system::cockpit_state).
# One key=value per line, nothing else, no translations: this is an interface.
show_state() {
    if systemctl is-active --quiet cockpit.socket 2>/dev/null; then
        say "socket=active"
    else
        say "socket=inactive"
    fi
    if remote_enabled; then
        say "remote=on"
    else
        say "remote=off"
    fi
    say "user=$(current_user)"
    if remote_enabled; then
        addresses | while read -r _ addr; do
            say "url=https://$addr:9090"
        done
    fi
}

show_status() {
    say "Cockpit (web administration)"
    say ""
    if systemctl is-active --quiet cockpit.socket 2>/dev/null; then
        say "  socket:  active"
    else
        say "  socket:  not running - start it with: sudo systemctl start cockpit.socket"
    fi
    if have ss; then
        listen=$(ss -ltn 2>/dev/null | awk '$4 ~ /:9090$/ {print $4}' | paste -sd' ' -)
        [ -n "$listen" ] && say "  listening on: $listen"
    fi
    case "$(password_state)" in
    P) say "  password: set" ;;
    *) say "  password: NOT set - Cockpit cannot log in until it is (see below)" ;;
    esac
    say ""
    if remote_enabled; then
        say "  Remote access: ENABLED on this network. Authorised users can open"
        addresses | while read -r _ addr; do
            say "    https://$addr:9090"
        done
        say "  (Cockpit uses a self-signed certificate, so the browser warns once.)"
        say "  Only reachable from this network; do not forward port 9090 from a router."
        say "  Turn it off with: refurb-cockpit off"
    else
        say "  Remote access: off (reachable only from this computer)."
        say "  To administer this machine from another computer on the same network:"
        say "    refurb-cockpit password   # once, if no password is set"
        say "    refurb-cockpit on"
        say "  Settings -> Remote does the same thing without a terminal."
    fi
    say ""
    say "  Local page: https://$LOOPBACK:9090"
}

show_ip() {
    if ! addresses | grep -q .; then
        say "No network address yet: connect to Wi-Fi or Ethernet first."
        return 1
    fi
    addresses | while read -r iface addr; do
        say "$iface  https://$addr:9090"
    done
}

case ${1:-status} in
on | enable)
    # The socket is a system unit, so this is an administrative action: sudo asks
    # for the account's password in this terminal, exactly like any other.
    # Running `sudo refurb-cockpit on` must work too; before, the root branch
    # fell out of the case and did nothing at all.
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo "$0" _on
    fi
    exec "$0" _on
    ;;
_on)
    target_user=$(current_user)
    install -d "$(dirname "$DROPIN")"
    cat >"$DROPIN" <<'CONF'
# Written by refurb-cockpit on: Cockpit answers on every interface so that an
# authorised browser on the local network can reach it. Remove this file (or
# run `refurb-cockpit off`) to go back to 127.0.0.1 only.
[Socket]
ListenStream=
ListenStream=9090
CONF
    # An installed system normally has the socket enabled already, but an image
    # or an administrator could have disabled it; "allow access" must work in
    # one click, not require a second trip to a terminal.
    systemctl unmask cockpit.socket >/dev/null 2>&1 || true
    systemctl enable cockpit.socket >/dev/null 2>&1 || true
    systemctl daemon-reload
    systemctl restart cockpit.socket
    say "Remote administration enabled. From another computer on this network:"
    addresses | while read -r _ addr; do
        say "  https://$addr:9090"
    done
    say "Log in as $target_user with its password. Port 9090 must not be forwarded"
    say "from a router. The browser will warn about Cockpit's self-signed certificate."
    show_status
    ;;
off | disable)
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo "$0" _off
    fi
    exec "$0" _off
    ;;
_off)
    rm -f "$DROPIN"
    systemctl daemon-reload
    systemctl restart cockpit.socket
    say "Remote administration disabled."
    show_status
    ;;
password | passwd)
    say "Cockpit logs in with this account's password. Type a new one when asked."
    # On the live medium the account has no password, so `passwd` would ask for
    # a current one that does not exist. Setting it through sudo avoids that and
    # is the same operation on an installed system.
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo passwd "$(current_user)"
    fi
    exec passwd "$(current_user)"
    ;;
ip | address | addresses)
    show_ip
    ;;
state)
    show_state
    ;;
open)
    exec brave-browser --new-window "https://$LOOPBACK:9090"
    ;;
status) show_status ;;
*)
    say "usage: refurb-cockpit [status|on|off|password|ip|state|open]" >&2
    exit 2
    ;;
esac
