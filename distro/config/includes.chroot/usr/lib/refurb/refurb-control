#!/bin/sh
# refurb-control - one implementation of the hardware controls.
#
# Called by the labwc media keys, the bar and the settings sliders, so volume,
# mute and brightness behave the same wherever they are changed. It also feeds
# the on-screen display (wob) so a key press gives visible feedback.
#
#   refurb-control volume up|down
#   refurb-control mute
#   refurb-control brightness up|down
#   refurb-control show-volume | show-brightness
set -u

# Called from labwc keybinds, which do not get a login shell's PATH.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# Amplification ceiling: 160% of normal, where laptop speakers begin to clip.
# WirePlumber stops at 150% by itself, so --limit is passed explicitly.
MAX=1.6
STEP=5
SINK=@DEFAULT_AUDIO_SINK@
FIFO="${XDG_RUNTIME_DIR:-/tmp}/refurb-osd.fifo"

have() { command -v "$1" >/dev/null 2>&1; }

# wob reads one percentage per line from its fifo. Silent no-op when the OSD is
# not running (text console, or the session is still starting).
osd() {
    [ -p "$FIFO" ] || return 0
    printf '%s\n' "$1" > "$FIFO" 2>/dev/null || true
}

wp() {
    have wpctl || return 1
    wpctl "$@" 2>/dev/null
}

# -> "<level> <muted 0|1>"; level is 0..1.6
sink_state() {
    out=$(wp get-volume "$SINK") || { echo "0 0"; return; }
    muted=0
    case $out in *MUTED*) muted=1 ;; esac
    # shellcheck disable=SC2086
    set -- $out
    echo "${2:-0} $muted"
}

show_volume() {
    # shellcheck disable=SC2046
    set -- $(sink_state)
    level=$1 muted=$2
    if [ "$muted" = 1 ] || [ "${level%%.*}" = 0 ]; then
        osd 0
        return
    fi
    pct=$(awk -v v="$level" 'BEGIN { printf "%d", v * 100 + 0.5 }')
    # The bar in the panel shows more than 100%; the OSD bar cannot.
    [ "$pct" -gt 100 ] && pct=100
    osd "$pct"
}

show_brightness() {
    for d in /sys/class/backlight/*; do
        [ -r "$d/brightness" ] || continue
        cur=$(cat "$d/brightness" 2>/dev/null) || continue
        max=$(cat "$d/max_brightness" 2>/dev/null) || continue
        [ "${max:-0}" -gt 0 ] || continue
        osd $((cur * 100 / max))
        return
    done
}

volume() {
    case ${1:-} in
    up)
        wp set-volume --limit "$MAX" "$SINK" "${STEP}%+" || return 1
        # Raising the volume while muted should be audible again, as it is on
        # every other desktop.
        wp set-mute "$SINK" 0
        ;;
    down)
        wp set-volume "$SINK" "${STEP}%-" || return 1
        ;;
    *)
        echo "usage: refurb-control volume up|down" >&2
        return 2
        ;;
    esac
    show_volume
}

mute() {
    wp set-mute "$SINK" toggle || return 1
    show_volume
}

brightness() {
    case ${1:-} in
    up|down) ;;
    *)
        echo "usage: refurb-control brightness up|down" >&2
        return 2
        ;;
    esac
    if have brightnessctl; then
        case $1 in
        up) brightnessctl -q set 10%+ || return 1 ;;
        down) brightnessctl -q set 10%- || return 1 ;;
        esac
        show_brightness
        return 0
    fi
    # No helper installed: drive the sysfs node directly. The udev rule makes it
    # writable for the desktop user, so the keys keep working on a minimal image.
    for d in /sys/class/backlight/*; do
        [ -w "$d/brightness" ] || continue
        cur=$(cat "$d/brightness" 2>/dev/null) || continue
        max=$(cat "$d/max_brightness" 2>/dev/null) || continue
        [ "${max:-0}" -gt 0 ] || continue
        step=$((max / 10))
        [ "$step" -gt 0 ] || step=1
        if [ "$1" = up ]; then
            val=$((cur + step))
        else
            val=$((cur - step))
        fi
        [ "$val" -gt "$max" ] && val=$max
        [ "$val" -lt 1 ] && val=1
        printf '%s\n' "$val" > "$d/brightness" 2>/dev/null || return 1
        show_brightness
        return 0
    done
    # No backlight at all (desktop machine, VM): the key is a silent no-op
    # rather than a fake success.
    return 1
}

case ${1:-} in
volume)
    shift
    volume "$@"
    ;;
mute) mute ;;
brightness)
    shift
    brightness "$@"
    ;;
show-volume) show_volume ;;
show-brightness) show_brightness ;;
*)
    echo "usage: refurb-control volume up|down | mute | brightness up|down | show-volume | show-brightness" >&2
    exit 2
    ;;
esac
