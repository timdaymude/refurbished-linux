#!/bin/sh
# refurb-control - one implementation of the hardware controls.
#
# Called by the labwc media keys, the bar and the settings sliders, so volume,
# mute and brightness behave the same wherever they are changed. It also feeds
# the on-screen display (wob) so a key press gives visible feedback.
#
# Every operation checks what the hardware did afterwards. A control that
# reports success while nothing changed is worse than one that fails loudly,
# because the next status poll then "corrects" the interface and the control
# looks broken.
#
#   refurb-control volume up|down
#   refurb-control mute
#   refurb-control brightness up|down
#   refurb-control show-volume | show-brightness
set -u

# Called from labwc keybinds, which do not get a login shell's PATH.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# Amplification ceiling: 160% of normal, where laptop speakers begin to clip.
# WirePlumber stops at 150% by itself, so --limit is passed explicitly.
MAX=1.6
STEP=5
SINK=@DEFAULT_AUDIO_SINK@
FIFO="${XDG_RUNTIME_DIR:-/tmp}/refurb-osd.fifo"

have() { command -v "$1" >/dev/null 2>&1; }

# wob reads one percentage per line from its fifo. Silent no-op when the OSD is
# not running (text console, or the session is still starting).
#
# The write is non-blocking on purpose: if the OSD is not reading, the key press
# must still change the volume instead of hanging here.
osd() {
    [ -p "$FIFO" ] || return 0
    if have timeout; then
        timeout 1 sh -c "printf '%s\n' \"\$1\" > \"\$2\"" sh "$1" "$FIFO" 2>/dev/null || true
    else
        printf '%s\n' "$1" > "$FIFO" 2>/dev/null || true
    fi
}

wp() {
    have wpctl || return 1
    wpctl "$@" 2>/dev/null
}

# -> "<level> <muted 0|1>"; level is 0..1.6
sink_state() {
    out=$(wp get-volume "$SINK") || { echo "0 0"; return; }
    muted=0
    case $out in *MUTED*) muted=1 ;; esac
    # shellcheck disable=SC2086
    set -- $out
    echo "${2:-0} $muted"
}

show_volume() {
    # shellcheck disable=SC2046
    set -- $(sink_state)
    level=$1
    muted=$2
    if [ "$muted" = 1 ] || [ "${level%%.*}" = 0 ]; then
        osd 0
        return
    fi
    pct=$(awk -v v="$level" 'BEGIN { printf "%d", v * 100 + 0.5 }')
    # The bar in the panel shows more than 100%; the OSD bar cannot.
    [ "$pct" -gt 100 ] && pct=100
    osd "$pct"
}

# Pick the backlight that actually drives the panel. A laptop often exposes a
# firmware stub (acpi_video0) next to the real GPU backlight; writing the stub
# changes a number and leaves the screen alone.
backlight_dirs() {
    # Real devices first, stubs last, so callers can just take the first one
    # that accepts a write.
    for d in /sys/class/backlight/*; do
        [ -e "$d/brightness" ] || continue
        case $d in
        *acpi_video*) continue ;;
        esac
        printf '%s\n' "$d"
    done
    for d in /sys/class/backlight/*; do
        [ -e "$d/brightness" ] || continue
        case $d in
        *acpi_video*) printf '%s\n' "$d" ;;
        esac
    done
}

show_brightness() {
    while IFS= read -r d; do
        [ -r "$d/brightness" ] || continue
        cur=$(cat "$d/brightness" 2>/dev/null) || continue
        max=$(cat "$d/max_brightness" 2>/dev/null) || continue
        [ "${max:-0}" -gt 0 ] || continue
        osd $((cur * 100 / max))
        return 0
    done <<EOF
$(backlight_dirs)
EOF
    return 1
}

# -> "<current> <max>" of the first readable device, or nothing
backlight_level() {
    while IFS= read -r d; do
        [ -r "$d/brightness" ] || continue
        cur=$(cat "$d/brightness" 2>/dev/null) || continue
        max=$(cat "$d/max_brightness" 2>/dev/null) || continue
        [ "${max:-0}" -gt 0 ] || continue
        printf '%s %s\n' "$cur" "$max"
        return 0
    done <<EOF
$(backlight_dirs)
EOF
    return 1
}

brightness_sysfs() {
    direction=$1
    while IFS= read -r d; do
        [ -w "$d/brightness" ] || continue
        cur=$(cat "$d/brightness" 2>/dev/null) || continue
        max=$(cat "$d/max_brightness" 2>/dev/null) || continue
        [ "${max:-0}" -gt 0 ] || continue
        step=$((max / 10))
        [ "$step" -gt 0 ] || step=1
        if [ "$direction" = up ]; then
            val=$((cur + step))
        else
            val=$((cur - step))
        fi
        [ "$val" -gt "$max" ] && val=$max
        [ "$val" -lt 1 ] && val=1
        printf '%s\n' "$val" > "$d/brightness" 2>/dev/null || continue
        after=$(cat "$d/brightness" 2>/dev/null) || continue
        if [ "$after" != "$cur" ]; then
            show_brightness
            return 0
        fi
    done <<EOF
$(backlight_dirs)
EOF
    return 1
}

# logind sets the backlight on behalf of the session's own user. It is the path
# the firmware's own keys take, it works when the sysfs node is still root-only
# (before the seat's ACL is applied), and it fails cleanly when there is no
# backlight at all. On a Chromebook this is usually the only interface that can
# reach intel_backlight from inside the desktop session.
brightness_logind() {
    direction=$1
    have busctl || return 1
    [ -n "${XDG_SESSION_ID:-}" ] || return 1
    while IFS= read -r d; do
        dev=${d##*/}
        cur=$(cat "$d/brightness" 2>/dev/null) || continue
        max=$(cat "$d/max_brightness" 2>/dev/null) || continue
        { [ -n "$cur" ] && [ "${max:-0}" -gt 0 ]; } || continue
        step=$((max / 10))
        [ "$step" -gt 0 ] || step=1
        if [ "$direction" = up ]; then
            val=$((cur + step))
            [ "$val" -le "$max" ] || val=$max
        else
            val=$((cur - step))
            [ "$val" -ge 0 ] || val=0
        fi
        # At the end of the range: report success, there is nothing to do.
        [ "$val" -eq "$cur" ] && return 0
        busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
            org.freedesktop.login1.Session SetBrightness ssu \
            backlight "$dev" "$val" >/dev/null 2>&1 || continue
        after=$(cat "$d/brightness" 2>/dev/null) || continue
        if [ "$after" != "$cur" ]; then
            show_brightness
            return 0
        fi
    done <<EOF
$(backlight_dirs)
EOF
    return 1
}

brightness() {
    case ${1:-} in
    up | down) direction=$1 ;;
    *)
        echo "usage: refurb-control brightness up|down" >&2
        return 2
        ;;
    esac

    # logind first: it works for the session's own user even when the sysfs node
    # is not writable, which is what a bare Chromebook looks like.
    brightness_logind "$direction" && return 0

    # Then sysfs: it is the kernel's own interface, needs no extra process and
    # is writable through the udev rule.
    brightness_sysfs "$direction" && return 0

    if have brightnessctl; then
        # brightnessctl exits 0 on laptops whose ACPI interface ignores the
        # request, and the device may be readable while its value never moves.
        # Compare the hardware before and after instead of trusting the tool.
        before=$(backlight_level) || before=
        case $direction in
        up) brightnessctl -q set 10%+ || true ;;
        down) brightnessctl -q set 10%- || true ;;
        esac
        after=$(backlight_level) || after=
        if [ -n "$before" ] && [ -n "$after" ] && [ "$before" != "$after" ]; then
            show_brightness
            return 0
        fi
    fi

    echo "refurb-control: no writable backlight device; brightness unchanged" >&2
    return 1
}

volume() {
    if ! have wpctl; then
        echo "refurb-control: wpctl is missing; install pipewire" >&2
        return 1
    fi
    case ${1:-} in
    up)
        wp set-volume --limit "$MAX" "$SINK" "${STEP}%+" || {
            echo "refurb-control: the audio sink refused the volume change" >&2
            return 1
        }
        # Raising the volume while muted should be audible again, as it is on
        # every other desktop.
        wp set-mute "$SINK" 0
        ;;
    down)
        wp set-volume "$SINK" "${STEP}%-" || {
            echo "refurb-control: the audio sink refused the volume change" >&2
            return 1
        }
        ;;
    *)
        echo "usage: refurb-control volume up|down" >&2
        return 2
        ;;
    esac
    show_volume
}

mute() {
    if ! have wpctl; then
        echo "refurb-control: wpctl is missing; install pipewire" >&2
        return 1
    fi
    wp set-mute "$SINK" toggle || return 1
    show_volume
}

case ${1:-} in
volume)
    shift
    volume "$@"
    ;;
mute) mute ;;
brightness)
    shift
    brightness "$@"
    ;;
show-volume) show_volume ;;
show-brightness) show_brightness ;;
*)
    echo "usage: refurb-control volume up|down | mute | brightness up|down | show-volume | show-brightness" >&2
    exit 2
    ;;
esac
