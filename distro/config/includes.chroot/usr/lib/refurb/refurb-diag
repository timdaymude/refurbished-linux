#!/bin/sh
# refurb-diag - collect everything needed to explain a hardware failure.
#
# Run it on the machine that shows the problem, while the problem is present:
#
#   refurb-diag            # writes ~/refurb-diag-<host>-<time>.tar.gz
#   refurb-diag /tmp/out   # writes into a directory you choose
#
# Nothing is uploaded anywhere. The archive contains hardware inventory, driver
# and firmware messages, the desktop session log, audio, network and Bluetooth
# service state, session and polkit authorization, backlight and input details,
# resource usage and the last errors of the current boot. Sections that need
# root report the permission error instead of aborting, so the rest is still
# collected. No Wi-Fi password, key or credential is included: the pass at the
# end strips anything that looks like one, and `nmcli` is never asked for
# secrets.
set -u

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

stamp=$(date +%Y%m%d-%H%M%S)
host=$(hostname 2>/dev/null || echo reawakening-pc)
base=${1:-"$HOME/refurb-diag-$host-$stamp"}
mkdir -p "$base" 2>/dev/null || base="/tmp/refurb-diag-$host-$stamp"
mkdir -p "$base" || exit 1

say() { printf 'collecting %s\n' "$1"; }

# Run a command into a file, recording the command line even when it fails.
run() {
    out=$1
    shift
    {
        printf '$ %s\n' "$*"
        "$@" 2>&1
        printf '\n[exit %s]\n' "$?"
    } >"$base/$out" 2>&1
}

# Same, but the command is a shell fragment (pipes, globs).
run_shell() {
    out=$1
    shift
    {
        printf '$ %s\n' "$*"
        sh -c "$*" 2>&1
        printf '\n[exit %s]\n' "$?"
    } >"$base/$out" 2>&1
}

say "identity"
{
    echo "collected: $(date -Is)"
    echo "host: $host"
    echo "user: $(id)"
    echo "kernel: $(uname -a)"
    echo "session: XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-unset} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset} XDG_SESSION_ID=${XDG_SESSION_ID:-unset}"
    echo "desktop: refurb-shell $(refurb-shell --version 2>/dev/null | sed 's/^refurb-shell //')"
    echo "compositor: $(labwc --version 2>/dev/null | head -1)"
    echo "uptime: $(uptime 2>/dev/null)"
    echo
    echo "No password, key or credential is written to this directory."
} >"$base/00-summary.txt" 2>&1
run 01-os-release.sh cat /etc/os-release
run 02-kernel.sh uname -a

say "hardware inventory"
run 10-pci.sh lspci -nnk
run 11-usb.sh lsusb
run 12-cpu.sh lscpu
run 13-dmi.sh dmidecode -t system -t baseboard
run 14-memory.sh free -m
run_shell 15-storage.sh 'df -h; echo; lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS 2>/dev/null'

say "session and permissions"
# The r8 session is a real logind login. These files show whether that is true on
# this machine and which authorizations follow from it - without them, "polkit
# said no" cannot be told apart from "there is no session at all".
run_shell 16-session.sh 'loginctl list-sessions --no-legend; echo; loginctl show-session --property=Id,Type,Class,Active,State,Seat,Remote,TTY,Display,Desktop,Service,Scope 2>/dev/null; echo; echo "-- seat"; loginctl show-seat seat0 --property=Id,ActiveSession,CanGraphical 2>/dev/null'
run_shell 17-user-instance.sh 'systemctl --user is-system-running 2>&1; echo; systemctl --user list-units --no-pager 2>&1 | head -40; echo; systemctl --user status pipewire.socket wireplumber.service --no-pager -l 2>&1 | head -40'
run_shell 18-runtime-dir.sh 'ls -l "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" 2>&1'
# pkcheck asks the authority the same question the desktop asks. Exit 0 means
# allowed; 1/2/3 mean the authorization failed, which is the failure being
# reported. Nothing is changed and no password dialog is raised.
run_shell 19-polkit.sh 'for action in \
        org.freedesktop.NetworkManager.network-control \
        org.freedesktop.NetworkManager.enable-disable-wifi \
        org.freedesktop.NetworkManager.settings.modify.system \
        org.freedesktop.udisks2.filesystem-mount \
        org.freedesktop.udisks2.eject-media \
        org.blueman.rfkill.setstate \
        org.freedesktop.login1.power-off \
        org.freedesktop.login1.reboot; do
    pkcheck --action-id "$action" --process $$ >/dev/null 2>&1
    printf "%-56s exit %s\n" "$action" "$?"
done; echo; ls -l /etc/polkit-1/rules.d/ /usr/share/polkit-1/rules.d/ 2>&1'

say "network"
run 20-rfkill.sh rfkill list
run 21-nmcli-device.sh nmcli -t device status
run 22-nmcli-radio.sh nmcli radio
run 23-nmcli-connections.sh nmcli -t -f NAME,TYPE,DEVICE connection show
run 24-iw-dev.sh iw dev
run 25-ip-link.sh ip -br link
run_shell 26-wifi-driver.sh 'lspci -nnk | grep -A4 -i -E "network|wireless"; echo; lsmod | grep -i -E "iwl|rtw|ath|mt76|brcm"'
run_shell 27-wifi-firmware.sh 'dmesg 2>/dev/null | grep -i -E "firmware|iwlwifi|rtw|ath10k|ath11k|mt76|brcmfmac" | tail -80'
run 28-networkmanager-log.sh journalctl -u NetworkManager -b --no-pager
run 29-nm-config.sh nmcli -f connectivity,device general

say "audio"
run 30-wpctl-status.sh wpctl status
run 31-wpctl-sink.sh wpctl inspect @DEFAULT_AUDIO_SINK@
run 32-aplay.sh aplay -l
run_shell 33-sound-modules.sh 'cat /proc/asound/cards 2>/dev/null; echo; lsmod | grep -E "^snd" | head -30'
run_shell 34-audio-log.sh 'cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/refurb-audio.log" 2>/dev/null; echo; ls -l "${XDG_RUNTIME_DIR:-/tmp}" 2>/dev/null | head -40'
run_shell 35-audio-processes.sh 'ps -eo pid,user,comm,args | grep -E "pipewire|wireplumber|pulse" | grep -v grep; echo; systemctl --user --no-pager status pipewire pipewire-pulse wireplumber 2>&1 | head -30'

say "bluetooth"
run_shell 36-bt-devices.sh 'bluetoothctl list 2>&1; echo; bluetoothctl devices 2>&1; echo; bluetoothctl show 2>&1'
run_shell 37-bt-service.sh 'systemctl status bluetooth --no-pager -l 2>&1; echo; busctl tree org.bluez 2>&1 | head -20'
run_shell 38-bt-log.sh 'journalctl -u bluetooth -b --no-pager 2>&1 | tail -120'
run_shell 39-bt-modules.sh 'lsmod | grep -i -E "bluetooth|btusb|btintel"; echo; dmesg 2>/dev/null | grep -i -E "bluetooth|hci|firmware" | tail -60'

say "display"
run 40-wlr-randr.sh wlr-randr
run_shell 41-drm.sh 'for f in /sys/class/drm/*/status; do printf "%s: %s\n" "$f" "$(cat "$f" 2>/dev/null)"; done'
run_shell 42-gpu-driver.sh 'lsmod | grep -E "^(i915|amdgpu|nouveau|radeon|virtio_gpu)"; echo; dmesg 2>/dev/null | grep -i -E "i915|amdgpu|nouveau|drm" | tail -60'
run 43-wayland-info.sh wayland-info
run_shell 44-renderer.sh 'echo "WLR_RENDERER_ALLOW_SOFTWARE=${WLR_RENDERER_ALLOW_SOFTWARE:-unset}"; echo; dmesg 2>/dev/null | grep -i -E "glx|egl|mesa|softpipe|llvmpipe" | tail -30'

say "backlight"
{
    echo '$ ls -l /sys/class/backlight'
    ls -l /sys/class/backlight 2>&1
    for d in /sys/class/backlight/*; do
        [ -e "$d" ] || continue
        echo
        echo "== $d"
        stat -c 'mode=%A owner=%U:%G' "$d/brightness" 2>&1
        echo "type=$(cat "$d/type" 2>/dev/null)"
        echo "brightness=$(cat "$d/brightness" 2>/dev/null)"
        echo "max_brightness=$(cat "$d/max_brightness" 2>/dev/null)"
        echo "actual_brightness=$(cat "$d/actual_brightness" 2>/dev/null)"
        echo "bl_power=$(cat "$d/bl_power" 2>/dev/null)"
    done
    echo
    echo '$ brightnessctl -l'
    brightnessctl -l 2>&1
    echo
    echo '$ brightnessctl -m'
    brightnessctl -m 2>&1
    echo
    echo '$ ls -l /etc/udev/rules.d/90-refurb-backlight.rules'
    cat /etc/udev/rules.d/90-refurb-backlight.rules 2>&1
} >"$base/50-backlight.txt" 2>&1

say "input and keyboard"
run 51-input-devices.sh cat /proc/bus/input/devices
run 52-libinput.sh libinput list-devices
run_shell 53-input-driver.sh 'dmesg 2>/dev/null | grep -i -E "input|keyboard|touchpad|atkbd|psmouse" | tail -60'
run_shell 54-keymap.sh 'localectl status 2>/dev/null; echo; ls -l /etc/default/keyboard 2>/dev/null; cat /etc/default/keyboard 2>/dev/null; echo; setxkbmap -print 2>/dev/null'
# Key events as the kernel delivers them. Three seconds, then stop: the tester is
# asked to press the media and brightness keys during the collection.
run_shell 55-key-events.sh 'ls -l /dev/input/ 2>&1 | head -20; echo; if [ -r /dev/input/event0 ]; then timeout 3 libinput debug-events --show-keycodes 2>&1 | head -60; else echo "no read access to /dev/input (the account is not in the input group)"; fi'
# The keyboard remap and the evdev codes behind the top row: an F7 that opens
# Brave's caret browsing shows up here as key code 93.
run_shell 56-keyboard-hwdb.sh 'for d in /sys/class/input/input*/name; do n=$(cat "$d" 2>/dev/null) || continue; echo "== $n"; cat "${d%/name}/id/modalias" 2>/dev/null; done; echo; systemd-hwdb query "evdev:atkbd:dmi:bvn*:bvr*:bd*:svnGOOGLE*:pn*" 2>&1 | head -20; echo; ls -l /etc/udev/hwdb.d/70-refurb-chromebook-keys.hwdb 2>&1'
# Hardware video decoding: whether VA-API exists at all, and what it can decode.
run_shell 45-vaapi.sh 'ls -l /dev/dri 2>&1; echo; vainfo 2>&1 | head -40'
# Audio path: the selected sink, its volume and the mixer controls behind it.
# 160% is PipeWire's software gain; if the ALSA control it feeds is low, the
# speakers stay quiet however high the slider goes.
run_shell 38-audio-levels.sh 'wpctl status 2>&1 | head -40; echo; wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>&1; echo; wpctl inspect @DEFAULT_AUDIO_SINK@ 2>&1 | head -30; echo; amixer -c0 contents 2>&1 | head -80'
# Whether the analog sink is allowed to suspend when idle: this is the r12
# Jellyfin audio-delay fix, and it is the first thing to check if sound is
# still late on real hardware.
run_shell 38b-audio-suspend.sh 'wpctl inspect @DEFAULT_AUDIO_SINK@ 2>&1 | grep -i -E "suspend|state|node.name|media.class"; echo; wireplumber --version 2>&1; echo; cat /etc/wireplumber/wireplumber.conf.d/51-refurb-audio.conf 2>&1'
# Zombie processes: children the shell never waited for used to sit here.
run_shell 19-resources.sh 'ps -eo stat,pid,ppid,comm --sort=stat | head -40; echo; echo "-- zombies"; ps -eo stat,pid,ppid,comm,args | awk "\$1 ~ /^Z/"'

run_shell 56-keybinds.sh 'grep -n "XF86\|keybind" /etc/xdg/labwc/rc.xml 2>/dev/null | head -40'
# What the compositor itself was given: an XKB variable that changes the layout
# or a missing keymap root explains keys that never reach a binding.
run_shell 57-labwc-env.sh 'p=$(pgrep -x labwc 2>/dev/null | head -1); echo "labwc pid: ${p:-none}"; [ -n "$p" ] && tr "\\0" "\\n" < "/proc/$p/environ" 2>/dev/null | grep -i -E "xkb|keymap|wayland_display|xdg_session|xdg_runtime"'
run_shell 58-backlight-values.sh 'for d in /sys/class/backlight/*; do echo "== $d"; ls -l "$d" 2>&1; printf "brightness="; cat "$d/brightness" 2>&1; printf "max="; cat "$d/max_brightness" 2>&1; done'
run_shell 59-keyprobe.sh 'echo "Run refurb-keys in the desktop and press the keys that do not work:"; echo "its keycode lines, plus the table below, say whether the key reaches the compositor."; echo; echo "  224 brightness down   225 brightness up   (XF86MonBrightnessDown/Up)"; echo "  113 mute             114 volume down      115 volume up     (XF86Audio*)"; echo "  93  F6  94 F7  95 F8  96 F9  97 F10 (top row in F-key mode: use Super+F6..F10)"; echo; command -v wev || echo "wev not installed (libinput keycodes are collected above)"'

say "desktop session"
run_shell 60-session-log.sh 'log="${XDG_STATE_HOME:-$HOME/.local/state}/refurb/session.log"; echo "log: $log"; tail -n 300 "$log" 2>/dev/null'
run_shell 61-shell-debug.sh 'tail -n 200 /tmp/refurb-debug.log 2>/dev/null || echo "no REFURB_SHELL_DEBUG log"'
run_shell 62-shell-journal.sh 'journalctl --user -b --no-pager 2>&1 | tail -200'
run_shell 63-session-processes.sh 'ps -eo pid,ppid,pcpu,pmem,rss,etime,comm,args --sort=-pcpu | head -30'
run_shell 64-labwc-config.sh 'for f in /etc/xdg/labwc/rc.xml "$HOME/.config/labwc/rc.xml"; do echo "== $f"; ls -l "$f" 2>&1; sha256sum "$f" 2>&1; done'
run_shell 65-notifications.sh 'pgrep -a mako; echo; busctl --user status org.freedesktop.Notifications 2>&1 | head -5; echo; ls -l /etc/xdg/mako/config 2>&1'
# Alt+Z dictation: the engine, the model, the tools it types with, and the last
# run's log. If dictation fails on hardware, this says which part is missing.
run_shell 66-dictation.sh 'refurb-dictate status 2>&1; echo; python3 -c "import vosk; print(vosk.__file__)" 2>&1; echo; du -sh /usr/share/refurb/vosk/model 2>&1; echo; command -v wtype pw-record python3 2>&1; echo; cat "${XDG_RUNTIME_DIR:-/tmp}/refurb-dictate.state" 2>&1; echo; tail -n 40 "${XDG_RUNTIME_DIR:-/tmp}/refurb-dictate.log" 2>&1'

say "resources and errors"
run_shell 70-resources.sh 'free -m; echo; cat /proc/loadavg; echo; cat /proc/pressure/cpu /proc/pressure/io /proc/pressure/memory 2>/dev/null; echo; vmstat 1 3'
run_shell 71-errors.sh 'journalctl -b -p err --no-pager | tail -120'
run_shell 72-dmesg.sh 'dmesg | tail -150'
run_shell 73-oom.sh 'dmesg 2>/dev/null | grep -i -E "oom|killed process"; journalctl -b --no-pager 2>/dev/null | grep -i -E "oom-kill|killed process" | tail -20'
run_shell 74-coredumps.sh 'command -v coredumpctl >/dev/null 2>&1 && coredumpctl list --no-pager 2>&1 || echo "coredumpctl not installed"'
run_shell 75-controls.sh 'echo "-- refurb-control show-volume"; refurb-control show-volume 2>&1; echo "-- wpctl"; wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>&1; echo "-- wpctl available?"; command -v wpctl; echo "-- wob fifo"; ls -l "${XDG_RUNTIME_DIR:-/tmp}/refurb-osd.fifo" 2>&1'

say "packages"
run_shell 80-versions.sh 'for p in labwc pipewire wireplumber network-manager wpasupplicant bluez brightnessctl wob swaylock libxkbcommon0 xkb-data mako-notifier blueman nm-connection-editor pavucontrol polkitd libpam-systemd dbus-user-session; do printf "%-22s %s\n" "$p" "$(dpkg-query -W -f="\${Version}" "$p" 2>/dev/null || echo missing)"; done'

# Credentials must never leave the machine, whatever a log happened to print.
# Every collected text file is scanned for the shapes NetworkManager, wpa_supplicant
# and Bluetooth pairing use.
say "removing anything that looks like a credential"
find "$base" -type f 2>/dev/null | while read -r file; do
    sed -i -E \
        -e 's/(psk|password|passwd|wep-key[0-9]?)=[^[:space:]]+/\1=<redacted>/Ig' \
        -e 's/(private[_-]?key|pre-shared-key)=[^[:space:]]+/\1=<redacted>/Ig' \
        -e 's/(identity|pin)=[^[:space:]]+/\1=<redacted>/Ig' \
        "$file" 2>/dev/null || true
done

archive="$base.tar.gz"
if tar -czf "$archive" -C "$(dirname "$base")" "$(basename "$base")" 2>/dev/null; then
    printf '\nDiagnostics written to:\n  %s\n  %s\n' "$base" "$archive"
    printf '\nSend the .tar.gz file; it contains no passwords (credentials are stripped) and\n'
    printf 'nothing is uploaded. Physical-hardware checks can only be judged from a\n'
    printf 'collection made on that machine: QEMU results are marked as simulated.\n'
else
    printf '\nDiagnostics written to: %s\n(could not create a tar.gz; the directory is complete)\n' "$base"
fi
