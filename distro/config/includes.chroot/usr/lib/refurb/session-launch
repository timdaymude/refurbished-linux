#!/bin/sh
# Bring the session's background services up, then run the compositor.
#
# The audio daemons used to be started here by hand, because the desktop was
# started from a system unit and had no systemd user instance to start them.
# Now that the session is a real logind login, the packaged user units do it:
# pipewire and pipewire-pulse are socket-activated, wireplumber is pulled in by
# pipewire, and all three restart themselves if they die - inside the same user
# manager and session bus as the compositor. The only thing left to do here is
# wait until the graph answers, so the volume shown at login is the real one.
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
log="$runtime/refurb-audio.log"

start_audio() {
    command -v pipewire >/dev/null 2>&1 || return 0
    if systemctl --user show-environment >/dev/null 2>&1; then
        # Same units a Debian desktop session uses. Explicit because a chroot
        # build cannot run `systemctl --user preset`, so the wants links are
        # created by the image build (see 0500-session.hook.chroot).
        systemctl --user start \
            pipewire.socket pipewire-pulse.socket wireplumber.service \
            >>"$log" 2>&1 || true
    else
        # No user manager: fall back to plain processes rather than a desktop
        # with no sound at all.
        pipewire >>"$log" 2>&1 &
        command -v pipewire-pulse >/dev/null 2>&1 && pipewire-pulse >>"$log" 2>&1 &
        command -v wireplumber >/dev/null 2>&1 && wireplumber >>"$log" 2>&1 &
    fi
    i=0
    while [ "$i" -lt 50 ]; do
        wpctl status >/dev/null 2>&1 && return 0
        i=$((i + 1))
        sleep 0.1
    done
}

start_audio

# One-shot mixer setup: with the software mixer enabled by the WirePlumber
# rule, the codec's speaker/PCM controls must sit at 0 dB so the gain above
# 100% is not compensating for an attenuation below it. Returns immediately
# when there is no sound card, so a machine without audio still logs in.
[ -x /usr/lib/refurb/refurb-audio ] && /usr/lib/refurb/refurb-audio init >/dev/null 2>&1 || true

exec labwc
