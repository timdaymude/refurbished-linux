#!/bin/sh
# Prepare the desktop account's home directory for a real login.
#
# This used to be the launcher of the whole session: it resolved the account and
# ran the desktop through runuser from a system unit. The session now starts from
# the account's own login on tty1 (see /etc/profile.d/zz-refurb-desktop.sh), so
# all that is left for root to do is the one thing a user cannot do: make the
# home directory theirs.
#
# The image is built without root, so a home directory can end up owned by the
# account that ran the build. A root-owned ~/.config makes the login shell and
# the desktop fail in confusing ways, so it is repaired before getty on tty1
# starts (refurb-session-prepare.service).
set -eu

target=""
for uid in $(awk -F: '$3 >= 1000 && $3 < 60000 {print $3}' /etc/passwd | sort -n); do
    entry=$(getent passwd "$uid" || true)
    [ -n "$entry" ] || continue
    name=$(printf '%s' "$entry" | cut -d: -f1)
    shell=$(printf '%s' "$entry" | cut -d: -f7)
    case "$shell" in */nologin|*/false|"") continue ;; esac
    target=$name
    break
done

if [ -z "$target" ]; then
    echo "refurb-session-prepare: no desktop account with uid >= 1000 exists" >&2
    exit 1
fi

uid=$(id -u "$target")
gid=$(id -g "$target")
home=$(getent passwd "$target" | cut -d: -f6)

if [ -n "$home" ]; then
    [ -d "$home" ] || mkdir -p "$home" 2>/dev/null || true
    # Contents too, not just the directory: a skeleton file left owned by root
    # makes bash print ".bashrc: Permission denied" on every terminal.
    chown -R "$uid:$gid" "$home" 2>/dev/null || chown "$uid:$gid" "$home" 2>/dev/null || true
    chmod 0700 "$home" 2>/dev/null || true
fi

echo "refurb-session-prepare: $target (uid $uid) owns $home"
