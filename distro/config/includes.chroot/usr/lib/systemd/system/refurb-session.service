[Unit]
Description=Refurbished Linux desktop session
Documentation=https://refurbishedlinux.org/
After=systemd-user-sessions.service systemd-logind.service network.target
Conflicts=getty@tty1.service
# Never give up restarting: a dead compositor must not leave a black screen.
StartLimitIntervalSec=0

[Service]
Type=simple
# The account is resolved at start time by the launcher: hard-coding a uid here
# stopped the session from ever spawning on the live image (systemd status
# 217/USER), which left a black screen with no explanation.
ExecStart=/usr/lib/refurb/session-start
StandardOutput=journal
StandardError=journal
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_CLASS=user
# A dead compositor must not leave a black screen.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical.target
