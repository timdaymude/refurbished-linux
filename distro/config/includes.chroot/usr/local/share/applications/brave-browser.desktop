[Desktop Entry]
Type=Application
Name=Brave
GenericName=Web Browser
Comment=Fast, private web browser
# VA-API: let Chromium decode video on the GPU instead of in software. On a
# dual-core machine without it, a 720p video is most of the CPU.
Exec=brave-browser --enable-features=VaapiVideoDecodeLinuxGL %U
Icon=brave-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
X-Refurb-Pin=1
# Pinned to the taskbar as well: the icon is there when Brave is closed, which
# is what a Windows user reaches for first.
X-Refurb-Taskbar=1
X-Refurb-Group=web
