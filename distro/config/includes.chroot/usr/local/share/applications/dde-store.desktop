[Desktop Entry]
Type=Application
Name=App Store
Comment=Find, install and remove applications
Exec=/usr/bin/dde-store %U
Icon=deepin-app-store
Terminal=false
StartupNotify=true
Categories=System;PackageManager;
Keywords=Package;Installer;App;Store;Software;
MimeType=x-scheme-handler/appstream;
X-Refurb-Group=system
