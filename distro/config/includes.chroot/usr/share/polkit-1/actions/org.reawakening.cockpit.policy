<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <!--
    One action, two directions: the same helper turns local-network access to
    Cockpit on and off. Making this an admin action is deliberate: exposing a
    login page on the LAN is a security decision, so it needs the account's
    password, not a click by whoever is at the keyboard.

    pkexec matches org.freedesktop.policykit.exec.path, so Settings → Remote
    can run `pkexec /usr/lib/refurb/refurb-cockpit on` and the user sees this
    description in the agent's dialog instead of a generic "run a program".
  -->
  <vendor>Reawakening OS</vendor>
  <vendor_url>https://github.com/timdaymude/refurbished-linux</vendor_url>

  <action id="org.reawakening.cockpit.remote">
    <description>Allow Cockpit access from the local network</description>
    <message>Authentication is required to allow web administration (Cockpit) from other computers on this network.</message>
    <icon_name>preferences-system-network</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/refurb/refurb-cockpit</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
