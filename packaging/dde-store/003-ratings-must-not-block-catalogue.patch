     QNetworkRequest request(QUrl("https://odrs.gnome.org/1.0/reviews/api/ratings"));
-    networkManager->get(request);
+    // Star ratings are a nicety; the catalogue is local. The store used to wait
+    // for this request before it would show a single category, so an offline
+    // machine, a captive portal or a network whose only answer is an IPv6
+    // address this host cannot reach left the store permanently empty.
+    request.setTransferTimeout(4000);
+    QNetworkReply *reply = networkManager->get(request);
     qDebug() << "[ RATINGS ] Fetching ratings...";
-    connect(networkManager, &QNetworkAccessManager::finished, this, [ = ] (QNetworkReply *reply) {
-        QByteArray data = reply->readAll();
-        QJsonObject array = QJsonDocument::fromJson(data).object();
-        for (const QString &key : array.keys()) {
-            ratingsList.insert(key, array.value(key).toObject());
-        }
-        emit(fetched());
-        available = true;
-        qDebug() << "[ RATINGS ] Ratings fetched";
-        disconnect(this, &RatingsHelper::fetched, nullptr, nullptr);
+    connect(reply, &QNetworkReply::finished, this, [ = ] {
+        const QByteArray data = reply->readAll();
+        reply->deleteLater();
+        finish(data);
     });
+    QTimer::singleShot(4000, this, [ = ] { finish(QByteArray()); });
+}
+
+void RatingsHelper::finish(const QByteArray &data)
+{
+    if (done)
+        return;
+    done = true;
+    QJsonObject array = QJsonDocument::fromJson(data).object();
+    for (const QString &key : array.keys()) {
+        ratingsList.insert(key, array.value(key).toObject());
+    }
+    available = !array.isEmpty();
+    emit(fetched());
+    qDebug() << "[ RATINGS ]"
+             << (available ? "Ratings fetched"
+                           : "Ratings unavailable; showing the catalogue without them");
 }
 
